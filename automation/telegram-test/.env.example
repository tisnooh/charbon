# Set secrets only on a secure server or in a local untracked .env file.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OWNER_TELEGRAM_ID=
# This standalone build refuses every channel other than CHARBON TEST.
TEST_CHANNEL_ID=-1003912244927
SQLITE_PATH=/data/charbon-test.sqlite3

# Safety defaults. Do NOT enable until a human has verified the tests.
ENABLE_PUBLISH=false
ENABLE_ASSISTANT=false
# Leave false while the existing Make webhook is configured.
ALLOW_WEBHOOK_TAKEOVER=false
